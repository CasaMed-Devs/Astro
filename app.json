{
  "expo": {
    "name": "Astro108",
    "slug": "astro108",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "astro101",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.astro101",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#FEFCF3"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FEFCF3"
        }
      ],
      "expo-system-ui",
      [
        "expo-build-properties",
        {
          "android": {
            "useLegacyPackaging": false
          }
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "4636056799964613",
          "clientToken": "7bc6810c4b06e7188e16d5ca28632a03",
          "displayName": "Astro108",
          "scheme": "fb4636056799964613",
          "advertiserIDCollectionEnabled": true,
          "autoLogAppEventsEnabled": true,
          "isAutoInitEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "newArchEnabled": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "615634d0-9f4b-4dc8-bad4-42ee295b7319"
      }
    },
    "owner": "animesh1024s-team"
  }
}
