# Backend-only secrets. Never commit the real .env file (it's git-ignored)
# and never prefix any of these with EXPO_PUBLIC_.

PORT=3000

# --- Firebase Admin SDK ---
# From Firebase Console > Project settings > Service accounts > Generate
# new private key. Paste the private_key value as-is; the app converts
# literal "\n" sequences back to real newlines at startup.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- App session tokens (replaces Firebase Auth) ---
# A long, random secret used to sign the app's own login session tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this instantly logs out every signed-in user.
JWT_SECRET=
JWT_EXPIRES_IN=30d

# --- Razorpay ---
# From the Razorpay dashboard (Settings > API Keys) and
# (Settings > Webhooks) respectively.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Pricing (leave unset to keep the paywall/report in "pricing coming
# soon" mode). Amounts are in the smallest currency unit (e.g. paise
# for INR: 49900 = ₹499.00).
SUBSCRIPTION_PRICE_AMOUNT=
SUBSCRIPTION_PRICE_CURRENCY=
REPORT_PRICE_AMOUNT=
REPORT_PRICE_CURRENCY=

# --- AI provider (astrologer replies + horoscopes + reports) ---
# Set AI_PROVIDER to "openai" or "anthropic" and fill in the matching key.
# Leave both unset and every AI-backed endpoint responds with a clear
# "temporarily unavailable" error instead of fake/mocked content.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Free-tier one-time message credits granted to every new user.
FREE_MESSAGE_CREDITS=10

# --- FreeAstrologyAPI.com (real Vedic chart calculation for the kundali report) ---
# From https://freeastrologyapi.com/ (sign up > dashboard). Used to
# calculate real planetary positions and Vimsottari dasha periods from the
# user's birth date/time/place, which then ground the AI-written report
# (see functions/src/services/astrology.service.ts). Without this key, the
# report endpoint returns a clear "temporarily unavailable" error.
FREE_ASTROLOGY_API_KEY=

# --- Google Places (birth-place search + coordinates) ---
# From Google Cloud Console > APIs & Services > Credentials. Enable "Places
# API (New)" on the same key, and restrict it (server IP or none, since
# this is only ever called from this backend, never the mobile app). Used
# to turn the birth-place search box into autocomplete suggestions and
# resolve the selected place to exact latitude/longitude (see
# functions/src/services/places.service.ts) — the UTC offset is then
# derived offline from the resolved coordinates via the `tz-lookup`
# package + the IANA timezone database, no separate Time Zone API needed.
# Without this key, /places/* endpoints return a clear "temporarily
# unavailable" error.
GOOGLE_PLACES_API_KEY=

# --- Persona API (personaapi.web.app) — third-party hosted AI-astrologer chat ---
# Server-side only secret — never expose via EXPO_PUBLIC_*. Without this
# key, /astrologers and /chats endpoints respond with a clear "temporarily
# unavailable" error instead of failing silently.
PERSONA_API_KEY=
