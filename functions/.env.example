# Backend-only secrets. Never commit the real .env file (it's git-ignored)
# and never prefix any of these with EXPO_PUBLIC_.

PORT=3000

# --- Firebase Admin SDK ---
# From Firebase Console > Project settings > Service accounts > Generate
# new private key. Paste the private_key value as-is; the app converts
# literal "\n" sequences back to real newlines at startup.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- App session tokens (replaces Firebase Auth) ---
# A long, random secret used to sign the app's own login session tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this instantly logs out every signed-in user.
JWT_SECRET=
JWT_EXPIRES_IN=30d

# --- Razorpay ---
# From the Razorpay dashboard (Settings > API Keys) and
# (Settings > Webhooks) respectively. KEY_SECRET and WEBHOOK_SECRET are
# server-only — never expose them to the mobile app or admin dashboard, and
# never commit real values here. Prefer Firebase Functions secrets
# (`firebase functions:secrets:set RAZORPAY_KEY_SECRET`) over a plaintext
# .env for production deploys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# No Razorpay Plan ID is needed: recurring billing uses Razorpay's
# Recurring Payments (card/UPI mandate registration + token charging, see
# services/razorpay.service.ts + services/mandate.service.ts), not the
# Plan-based Subscriptions product.

# Pricing. Amounts are in whole Rupees (e.g. 299 = ₹299.00) — Razorpay's API
# requires paise, but that conversion happens only at the one call site that
# talks to Razorpay (see rupeesToPaise in services/razorpay.service.ts), so
# every config value, admin dashboard field, and API body in this app stays
# in plain Rupees. These are only the fallback used until an admin sets a
# value from the admin dashboard's Pricing page — once set there, the
# Firestore-stored value (appConfig/paywallPricing) takes precedence.
#
# "Price of 1 credit". Drives the top-up conversion and how many credits an
# auto-debit grants. Cost per chat message is a fixed 1 credit regardless.
RUPEES_PER_CREDIT=1
# The Rs.1 mandate-registration (trial) charge, and the recurring auto-debit
# amount charged on day 2 and every 30 days after.
TRIAL_AMOUNT=1
TRIAL_CURRENCY=INR
SUBSCRIPTION_AMOUNT=299
SUBSCRIPTION_CURRENCY=INR
# Leave unset to keep the report in "pricing coming soon" mode.
REPORT_PRICE_AMOUNT=
REPORT_PRICE_CURRENCY=

# --- Wallet top-up ---
# Fallback limits for the wallet top-up feature, used until an admin sets
# appConfig/paywallPricing.topUp from the admin dashboard. Whole Rupees.
TOPUP_MIN_AMOUNT=50
TOPUP_MAX_AMOUNT=5000
TOPUP_CURRENCY=INR

# --- Admin dashboard (standalone app, see admin-dashboard/) ---
# Single shared password protecting the astrologer/pricing/user-lookup
# admin pages. Required for the admin dashboard to work at all; leave
# unset to keep it disabled.
ADMIN_PASSWORD=
# Exact origin the admin-dashboard app is served from (e.g.
# http://localhost:5174 for local dev, or its deployed URL) — required so
# the cross-origin cookie session can work at all (credentialed CORS can't
# use a wildcard origin).
ADMIN_DASHBOARD_ORIGIN=

# --- AI provider (astrologer replies + horoscopes + reports) ---
# Set AI_PROVIDER to "openai" or "anthropic" and fill in the matching key.
# Leave both unset and every AI-backed endpoint responds with a clear
# "temporarily unavailable" error instead of fake/mocked content.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# New users start with 0 credits and cannot chat at all until they complete
# the Rs.1 trial (which grants 5 credits) — see services/mandate.service.ts.
FREE_MESSAGE_CREDITS=0

# --- FreeAstrologyAPI.com (real Vedic chart calculation for the kundali report) ---
# From https://freeastrologyapi.com/ (sign up > dashboard). Used to
# calculate real planetary positions and Vimsottari dasha periods from the
# user's birth date/time/place, which then ground the AI-written report
# (see functions/src/services/astrology.service.ts). Without this key, the
# report endpoint returns a clear "temporarily unavailable" error.
FREE_ASTROLOGY_API_KEY=

# --- Google Places (birth-place search + coordinates) ---
# From Google Cloud Console > APIs & Services > Credentials. Enable "Places
# API (New)" on the same key, and restrict it (server IP or none, since
# this is only ever called from this backend, never the mobile app). Used
# to turn the birth-place search box into autocomplete suggestions and
# resolve the selected place to exact latitude/longitude (see
# functions/src/services/places.service.ts) — the UTC offset is then
# derived offline from the resolved coordinates via the `tz-lookup`
# package + the IANA timezone database, no separate Time Zone API needed.
# Without this key, /places/* endpoints return a clear "temporarily
# unavailable" error.
GOOGLE_PLACES_API_KEY=

# --- Persona API (personaapi.web.app) — third-party hosted AI-astrologer chat ---
# Server-side only secret — never expose via EXPO_PUBLIC_*. Without this
# key, /astrologers and /chats endpoints respond with a clear "temporarily
# unavailable" error instead of failing silently.
PERSONA_API_KEY=
