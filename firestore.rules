rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The app no longer authenticates directly against Firebase (OTP
    // verification and session tokens are handled by our own backend via
    // voicenSMS + a custom JWT — see functions/src/services/token.service.ts).
    // request.auth is therefore always null for client requests, so every
    // collection below is backend-only (Admin SDK bypasses these rules).
    // Only clearly public, read-only reference content is exposed to clients.

    // Doc ID is the user's own E.164 phone number (e.g. "+919876543210"),
    // not a generated/hashed id — see functions/src/utils/uid.ts.
    match /users/{phoneNumber} {
      allow read, write: if false;
    }

    // Personal/birth details (name, dob/tob/pob, gender), split out of
    // users/{uid} — see functions/src/services/userProfile.service.ts. Doc
    // id is a generated id, referenced by users/{uid}.userProfileId.
    match /userProfiles/{userProfileId} {
      allow read, write: if false;
    }

    match /chats/{chatId} {
      allow read, write: if false;

      match /messages/{messageId} {
        allow read, write: if false;
      }
    }

    // Doc id is a generated id, one per mandate-registration cycle — not the
    // user's phone number — see functions/src/services/mandate.service.ts's
    // startSubscriptionCycle. Referenced by users/{uid}.subscriptionId.
    match /subscriptions/{subscriptionId} {
      allow read, write: if false;
    }

    match /payments/{paymentId} {
      allow read, write: if false;
    }

    // Per-payment record incl. which channel confirmed it. Backend-only
    // (Admin SDK), same as payments.
    match /transactions/{transactionId} {
      allow read, write: if false;
    }

    // Every Razorpay order we created; what payment reconciliation checks.
    match /paymentOrders/{orderId} {
      allow read, write: if false;
    }

    // A Razorpay auto-debit charge that succeeded (money taken) whose local
    // crediting then failed — see mandate.service.ts's finalizeAutoDebitCharge.
    // Needs manual reconciliation; doc id = the Razorpay payment id.
    match /failedCredits/{paymentId} {
      allow read, write: if false;
    }

    // Doc data also includes a `phoneNumber` field mirroring the doc ID —
    // see functions/src/services/report.service.ts.
    match /reports/{phoneNumber} {
      allow read, write: if false;
    }

    // Thin chat-ownership doc, id = "{phoneNumber}_{personaProfileId}".
    match /personaChats/{sessionId} {
      allow read, write: if false;
    }

    match /personaConfig/{profileId} {
      allow read, write: if false;
    }

    match /otps/{phoneNumber} {
      allow read, write: if false;
    }

    // Public, read-only reference content.
    match /horoscopes/{sign}/daily/{date} {
      allow read: if true;
      allow write: if false;
    }

    match /appConfig/{document} {
      allow read: if true;
      allow write: if false;
    }
  }
}
