{
  "expo": {
    "name": "Astro101",
    "slug": "astro101",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "astro101",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.astro101",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#FEFCF3"
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FEFCF3"
        }
      ],
      "expo-system-ui",
      ["expo-build-properties", { "android": { "useLegacyPackaging": false } }]
    ],
    "experiments": {
      "typedRoutes": true,
      "newArchEnabled": true
    }
  }
}
