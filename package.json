{
  "name": "astro101",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "concurrently -n BACKEND,METRO -c yellow,cyan -k \"npm:backend:dev\" \"npm:start:app\"",
    "start:app": "expo start --dev-client",
    "android": "npm run android:app",
    "android:app": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "backend": "npm run build --prefix functions && node functions/lib/server.js",
    "backend:dev": "npm run dev --prefix functions",
    "backend:build": "npm run build --prefix functions",
    "backend:test": "npm test --prefix functions",
    "admin:build": "npm run build --prefix admin-dashboard",
    "admin:deploy": "npm run admin:build && firebase deploy --only hosting:admin"
  },
  "jest": {
    "preset": "jest-expo",
    "clearMocks": true,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/functions/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/cormorant-sc": "^0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "@tanstack/react-query": "^5.102.8",
    "expo": "^57.0.22",
    "expo-build-properties": "^57.0.17",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~6.0.15",
    "expo-font": "^57.0.4",
    "expo-linear-gradient": "^57.0.2",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "^1.45.0",
    "react": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-razorpay": "^3.0.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "jimp": "^1.6.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  }
}
