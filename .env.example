# Public config for the Expo app. EXPO_PUBLIC_* variables are bundled into
# the client and visible to anyone — never put secrets here.

# Which of the URLs below the app actually uses. One of: local | vercel | firebase
EXPO_PUBLIC_BACKEND_TARGET=firebase

# Local dev backend (ts-node-dev `functions/src/server.ts`). Use your
# computer's LAN IP, not localhost, when testing on a physical device.
EXPO_PUBLIC_API_URL_LOCAL=http://localhost:3000

# Vercel deployment of functions/api/index.ts.
EXPO_PUBLIC_API_URL_VERCEL=https://your-project.vercel.app

# Firebase Cloud Functions deployment of functions/src/index.ts (see
# functions/.env.example for the backend's own secrets).
EXPO_PUBLIC_API_URL_FIREBASE=https://your-project.web.app
