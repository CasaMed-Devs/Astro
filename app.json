{
  "expo": {
    "name": "Astro101",
    "slug": "astro101",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "astro101",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FEFCF3"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.astro101",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#FEFCF3"
      },
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-system-ui",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      ["expo-build-properties", { "android": { "useLegacyPackaging": false } }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
